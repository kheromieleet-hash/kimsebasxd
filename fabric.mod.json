{
  "schemaVersion": 1,
  "id": "inventoryhud",
  "version": "3.4.37",
  "name": "SCT Client",
  "description": "SCT Client with Inventory HUD +, Viewmodel, ClickGUI & Auto-Updater for Minecraft 26.3.",
  "authors": [
    "DmitryLovin",
    "inglettronald (DulkirMod)",
    "Client Developer"
  ],
  "contact": {
    "homepage": "https://github.com/kheromieallah/sestia"
  },
  "license": "MIT",
  "icon": "logo.png",
  "environment": "client",
  "languageAdapters": {
    "sct_bootstrap": "com.client.loader.SctBootstrapAdapter"
  },
  "entrypoints": {
    "client": [
      "dlovin.inventoryhud.fabric.InventoryHUDFabric",
      "com.client.mod.ClientMod"
    ],
    "modmenu": [
      "dlovin.inventoryhud.fabric.modmenu.ModMenuImpl"
    ]
  },
  "mixins": [
    "inventoryhud.mixins.json",
    "customclient.mixins.json"
  ],
  "jars": [
    {
      "file": "META-INF/jars/IAS-9.0.8+26.3-fabric.jar"
    }
  ],
  "depends": {
    "fabricloader": ">=0.19.3",
    "minecraft": "~26.3",
    "java": ">=25",
    "fabric-api": "*"
  }
}
